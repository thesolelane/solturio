# Core application
SOLTURIO_ENV_TARGET=beta
# Required only when you intentionally activate the production Supabase project.
# SOLTURIO_PRODUCTION_UNLOCK=ACTIVATE_PRODUCTION
AUTH_PROVIDER=local
# For AUTH_PROVIDER=local, set a private shared access code for bootstrap sign-in.
LOCAL_AUTH_ACCESS_CODE=replace-with-a-long-random-bootstrap-code
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Supabase environment guidance
# Keep Solturio Production and Beta Solturio Dev on separate Supabase projects.
# Beta Solturio Dev should use its own DATABASE_URL, BASE_URL, auth domain values, and non-production keys.
# Solturio Production should use its own DATABASE_URL, BASE_URL, auth domain values, and production-only keys.
# Do not share passwords, service-role keys, or database instances between beta and production.
#
# Recommended local workflow:
# - keep shared defaults and the target switch in .env or .env.local
# - keep Beta Solturio Dev secrets in .env.beta.local
# - keep Solturio Production secrets in .env.production.local
# - production stays locked until SOLTURIO_ENV_TARGET=production and
#   SOLTURIO_PRODUCTION_UNLOCK=ACTIVATE_PRODUCTION are both set
#
# Example Supabase Postgres format:
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Suggested environment mapping:
# - Beta Solturio Dev:
#   NODE_ENV=development
#   BASE_URL=https://beta.your-domain.example
#   DATABASE_URL=postgresql://postgres:[BETA_DB_PASSWORD]@db.[BETA_PROJECT_REF].supabase.co:5432/postgres
#   SOLANA_CLUSTER=devnet
# - Solturio Production:
#   NODE_ENV=production
#   BASE_URL=https://your-production-domain.example
#   DATABASE_URL=postgresql://postgres:[PROD_DB_PASSWORD]@db.[PROD_PROJECT_REF].supabase.co:5432/postgres
#   SOLANA_CLUSTER=mainnet-beta

# Database
DATABASE_URL=postgresql://user:password@host:5432/solturio

# Replit Auth / OIDC
# Only required when AUTH_PROVIDER=replit
REPLIT_DOMAINS=localhost:5000
REPL_ID=your_replit_app_id
ISSUER_URL=https://replit.com/oidc
SESSION_SECRET=replace-with-a-long-random-session-secret

# Encryption
WALLET_ENCRYPTION_KEY=replace-with-a-32-plus-character-wallet-encryption-key
SECRETS_ENCRYPTION_KEY=replace-with-a-64-char-hex-key-for-admin-secrets
MUSIC_MASTER_KEK=replace-with-a-64-char-hex-key-for-music-master-encryption

# Email / notifications
SENDGRID_API_KEY=your_sendgrid_api_key
NOREPLY_EMAIL=noreply@solturio.com
SUPPORT_EMAIL=support@solturio.com

# IPFS / Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=gateway.pinata.cloud

# Arweave
ARWEAVE_WALLET_KEY=your_arweave_wallet_jwk_json

# Solana / blockchain
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLT_MINT_ADDRESS=your_solt_mint_address
SOLTURIO_NFT_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCDYfVfbq4nDr8vFuWG
SOLTURIO_LAUNCH_DATE=2026-01-01T00:00:00.000Z

# Platform payment / treasury wallets
PLATFORM_SOL_WALLET=your_platform_sol_wallet
PLATFORM_BONK_WALLET=your_platform_bonk_wallet
PLATFORM_CATH_WALLET=your_platform_cath_wallet
PLATFORM_REVENUE_WALLET=your_platform_revenue_wallet
PLATFORM_OPERATIONS_WALLET=your_platform_operations_wallet
PLATFORM_REWARDS_WALLET=your_platform_rewards_wallet
TREASURY_SOL_WALLET=your_treasury_sol_wallet
TREASURY_CATH_ACCOUNT=your_treasury_cath_account

# Smart contract integration
SC_API_URL=https://your-smart-contract-api.example.com
SC_API_SECRET=your_smart_contract_api_secret

# Telegram quiz bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_QUIZ_CHAT_ID=your_telegram_quiz_chat_id

# Trademark / external APIs
USPTO_ODP_API_KEY=your_uspto_odp_api_key

# Feature toggles / development helpers
STUB_LICENSED=false

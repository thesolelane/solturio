# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=centurio_db

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Stripe Configuration (Optional - for payments)
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
TESTING_STRIPE_SECRET_KEY=sk_test_...
TESTING_VITE_STRIPE_PUBLIC_KEY=pk_test_...

# IPFS Configuration (Optional - for decentralized storage)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# Wallet Encryption (Required for production)
WALLET_ENCRYPTION_KEY=minimum-32-character-encryption-key-for-wallets

# Solana Configuration (Optional - for blockchain integration)
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Application Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@centurio.app

# OpenAI Configuration (Optional - for AI features)
OPENAI_API_KEY=sk-...

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-...
MIXPANEL_TOKEN=...

# Feature Flags
ENABLE_MINTING=false
ENABLE_IPFS=true
ENABLE_DEX_API=true
ENABLE_LEGAL_DOCS=true
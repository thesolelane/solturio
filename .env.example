# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── Encryption Keys ─────────────────────────────────────────────────────────
SECRETS_ENCRYPTION_KEY=        # 64-char hex (32 bytes) — admin secrets vault
WALLET_ENCRYPTION_KEY=         # AES-256 key — user wallet private keys
MUSIC_MASTER_KEK=              # Key encryption key — music IP assets

# ─── Blockchain / Solana ─────────────────────────────────────────────────────
SOLANA_RPC_URL=
SOLANA_CLUSTER=                # mainnet-beta or devnet
SOLTURIO_NFT_PROGRAM_ID=
SOLT_MINT_ADDRESS=
SOLTURIO_LAUNCH_DATE=          # ISO date string e.g. 2025-01-01T00:00:00Z

# ─── Platform Wallets ────────────────────────────────────────────────────────
PLATFORM_SOL_WALLET=
PLATFORM_CATH_WALLET=
PLATFORM_BONK_WALLET=
PLATFORM_REVENUE_WALLET=
TREASURY_SOL_WALLET=
TREASURY_CATH_ACCOUNT=

# ─── IPFS / Pinata ───────────────────────────────────────────────────────────
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY=

# ─── Arweave ─────────────────────────────────────────────────────────────────
ARWEAVE_WALLET_KEY=            # Stringified JSON of Arweave wallet

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_QUIZ_CHAT_ID=

# ─── Email / SendGrid ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
NOREPLY_EMAIL=
SUPPORT_EMAIL=

# ─── USPTO (Trademark Assistant) ─────────────────────────────────────────────
USPTO_ODP_API_KEY=             # Optional — falls back to mock data if not set

# ─── Smart Contract Service ──────────────────────────────────────────────────
SC_API_URL=
SC_API_SECRET=                 # HMAC-SHA256 signing secret

# ─── Replit Auth (auto-set by Replit — set manually if hosting elsewhere) ────
REPL_ID=
REPLIT_DOMAINS=
ISSUER_URL=

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=                      # development or production
PORT=5000

# ─── Feature Flags ───────────────────────────────────────────────────────────
STUB_LICENSED=                 # Set to true to bypass payment verification in dev
